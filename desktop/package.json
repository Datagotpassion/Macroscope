{
  "name": "platescope-desktop",
  "version": "0.1.0",
  "description": "PlateScope desktop app (Electron shell around the React UI)",
  "main": "main.js",
  "author": "PlateScope",
  "scripts": {
    "build:renderer": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "start": "npm run build:renderer && electron .",
    "start:fast": "electron .",
    "dist": "npm run build:renderer && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.platescope.desktop",
    "productName": "PlateScope",
    "files": ["main.js", "preload.js"],
    "extraResources": [{ "from": "../frontend/dist", "to": "renderer" }],
    "win": { "target": "nsis" },
    "directories": { "output": "release" }
  }
}
